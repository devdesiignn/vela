  },
  "homepage": "https://github.com/devdesiignn/receipt-intelligence-platform#readme",
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "markdownlint-cli": "^0.45.0",
    "prettier": "^3.9.6"
  }
}
