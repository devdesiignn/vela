{
  "name": "receipt-intelligence-platform",
  "version": "1.0.0",
  "description": "Docs-only hub repo for the Receipt Intelligence Platform — system plan and architecture diagram.",
  "private": true,
  "scripts": {
    "lint": "markdownlint README.md CLAUDE.md docs/*.md",
    "format": "prettier --write \"*.md\" \"docs/*.md\"",
