{
  "name": "vela",
  "version": "1.0.0",
  "description": "Docs-only hub repo for Vela (Receipt Intelligence Platform) — system plan and architecture diagram.",
  "private": true,
  "scripts": {
    "lint": "markdownlint README.md CLAUDE.md docs/*.md",
    "format": "prettier --write \"*.md\" \"docs/*.md\"",
    "format:check": "prettier --check \"*.md\" \"docs/*.md\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.md": [
      "markdownlint --fix",
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devdesiignn/vela.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/devdesiignn/vela/issues"
  },
  "homepage": "https://github.com/devdesiignn/vela#readme",
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "markdownlint-cli": "^0.49.1",
    "prettier": "^3.9.6"
  }
}
